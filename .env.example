# Meta Messenger webhook
META_VERIFY_TOKEN=choose_a_long_random_verify_token
META_APP_SECRET=your_meta_app_secret

# Admin dashboard login (change these before deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# AI product conversation (optional; bot has a basic fallback without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local SQLite database file; default: data/sales_bot.db
# DATABASE_PATH=data/sales_bot.db
PORT=8000
